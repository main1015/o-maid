# 数据库类型支持: sqlite | mysql | postgres
DB_TYPE=sqlite

# ================================
# SQLite 配置（本地默认）
# ================================
SQLITE_FILENAME=./data.db

# ================================
# MySQL 配置（线上环境）
# ================================
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_NAME=omaid

# ================================
# PostgreSQL 配置（线上环境）
# ================================
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_pg_password
# DB_NAME=omaid
# PG_SSL=false
